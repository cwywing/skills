/**
 * H5 设计 Token — 唯一真相源 (Single Source of Truth) · 模板
 *
 * 使用方式（对照 skill 的 references/token-taxonomy.md）：
 *  1. 替换品牌色（--color-primary 一族）为项目品牌色，其余语义结构保留。
 *  2. 尺度层数值可调（字号阶梯 / 4pt 间距 / 圆角），语义层命名尽量不动。
 *  3. 本文件是全项目唯一允许出现 hex 的文件（stylelint 白名单强制）。
 *  4. 半透明一律 rgba(var(--*-rgb), α)；新增颜色先在此登记语义 token。
 *  5. 暗黑模式：取消 [data-theme="dark"] 段注释，只重赋值语义 token——
 *     不是第二套命名法，是同一套语义的重新赋值。
 */

:root {
  /* ========== 颜色 · 品牌色 ========== */
  --color-primary: #1677ff;        /* ← 换成品牌主色 */
  --color-primary-dark: #0e5fd8;   /* 按压态/强调 */
  --color-primary-soft: #e8f3ff;   /* 浅底 */
  --color-primary-softer: #f5f9ff; /* 比 soft 更淡，渐变浅端 */
  --color-primary-rgb: 22, 119, 255;

  /* ========== 颜色 · 状态色四件套（主色 + 文字 + 底色 + 边框）========== */
  /* 成功 */
  --color-success: #52c41a;
  --color-success-text: #389e0d;
  --color-success-soft: #f6ffed;
  --color-success-border: #b7eb8f;

  /* 警告 */
  --color-warning: #ff7d00;
  --color-warning-text: #d48806;
  --color-warning-soft: #fff7e6;
  --color-warning-border: #ffd591;

  /* 危险 */
  --color-danger: #f53f3f;
  --color-danger-text: #cf1322;
  --color-danger-soft: #fff2f0;
  --color-danger-border: #ffccc7;
  --color-danger-text-rgb: 207, 19, 34;

  /* ========== 颜色 · 渠道色（语义独立于"成功"，禁止与 success 互为别名）========== */
  --color-wecom: #07c160;          /* 微信品牌绿 */
  --color-wecom-soft: #e8faf0;
  --color-wecom-rgb: 7, 193, 96;

  /* ========== 颜色 · 文字 ========== */
  --color-text: #1d2129;
  --color-text-rgb: 29, 33, 41;
  --color-text-secondary: #86909c;
  --color-text-secondary-strong: #4e5969; /* 比 secondary 深，描述/正文 */
  --color-text-muted: #c9cdd4;
  --color-text-on-primary: #ffffff;

  /* ========== 颜色 · 背景与边框 ========== */
  --color-bg-page: #f2f3f5;
  --color-bg-card: #ffffff;
  --color-bg-muted: #f7f8fa;   /* 输入区/占位框的素浅灰 */
  --color-bg-subtle: #fafafa;  /* 步进器/禁用态 */
  --color-bg-footer: #f5f7f6;
  --color-border: #e5e6eb;
  --color-border-rgb: 229, 230, 235;

  /* ========== 颜色 · 头图渐变 ========== */
  --color-hero-from: #1677ff;
  --color-hero-to: #3d8bff;
  --color-hero-3: #5a9dff;

  /* ========== 遮罩/白色三元组（供 rgba(var(--*-rgb), α)）========== */
  --color-overlay-rgb: 15, 23, 42;
  --color-white-rgb: 255, 255, 255;

  /* ========== 字号阶梯 ========== */
  /* 尺度层 */
  --fs-caption: 12px;
  --fs-sm: 13px;
  --fs-base: 14px;
  --fs-md: 15px;
  --fs-lg: 16px;
  --fs-xl: 17px;
  --fs-2xl: 20px;
  --fs-3xl: 22px;
  --fs-hero: 28px;
  /* 语义层（业务优先用这层） */
  --fs-body: var(--fs-base);
  --fs-hint: var(--fs-caption);
  --fs-title-nav: var(--fs-xl);
  --fs-title-hero: var(--fs-hero);

  /* ========== 间距阶梯（4pt grid）========== */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;
  /* 语义层 */
  --space-page-x: var(--space-4);
  --space-card-gap: var(--space-3);
  --space-card-padding: var(--space-4);
  --space-section: var(--space-6);

  /* ========== 圆角阶梯 ========== */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-pill: 999px;
  /* 语义层 */
  --radius-input: var(--radius-sm);
  --radius-card: var(--radius-md);
  --radius-panel: var(--radius-lg);

  /* ========== 阴影（SoT 内部允许 rgba；低频装饰阴影可保留裸值并注释用途）========== */
  --shadow-card: 0 4px 16px rgba(var(--color-primary-rgb), 0.08);
  --shadow-float: 0 8px 24px rgba(var(--color-text-rgb), 0.08);
  --shadow-pop: 0 16px 48px rgba(var(--color-overlay-rgb), 0.22);

  /* ========== 动效 ========== */
  --duration-fast: 0.12s;
  --duration-base: 0.15s;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);

  /* ========== 字体与布局 ========== */
  --font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --app-max-width: 430px;
  --nav-height: 48px;
}

/* ========== 暗黑模式（可选：取消注释启用）==========
   只重赋值语义 token；命名法与亮色完全一致。 */
